# index.html siempre revalida contra el ETag: un deploy nuevo se ve solo.
/index.html
  Cache-Control: no-cache

# Assets versionados por contenido (hashes de Vite): immutable por 1 año.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Capa legacy versionada con ?v=1 en index.html: caché inmutable por 1 año.
# Al modificar cualquier archivo en public/js/ o public/css/, subir el ?v en
# index.html para que se descargue la nueva versión.
/js/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/logo.webp
  Cache-Control: public, max-age=31536000, immutable

/google*.html
  Cache-Control: public, max-age=31536000, immutable